{
  "description": "Product and session context at start, open Action review before a Turn ends, and a local code-diff reminder before Intent review.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__talgent__advance_intent_status$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/review-code-diff.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/references/product.md\" && printf '\\nThe flow files named above are in %s/references/flows/.\\n' \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/knowledge-index.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/open-actions.mjs\"",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
